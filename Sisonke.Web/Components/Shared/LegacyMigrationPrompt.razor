@* Phase 5 §C — shown once per session (deferrable via sessionStorage, reappears next login;
   no permanent-dismiss control exists) to an authenticated user who administers a
   LegacyUnsubscribed organisation. Office bearers get the opt-in CTA (into the same onboarding
   wizard, entering at Step 2 since the org already exists); everyone else is told to ask their
   chairperson/treasurer, with a share link. Rendered from MainLayout so it appears on first
   authenticated page load each session. *@
@rendermode InteractiveServer
@using System.Security.Claims
@using Sisonke.Web.Data.Enums
@using Sisonke.Web.Services
@using Sisonke.Web.Services.Entitlements
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject MemberAccessService MemberAccessService
@inject StokvelService StokvelService
@inject IEntitlementService EntitlementService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inject ILogger<LegacyMigrationPrompt> Logger

@if (showSubscriptionPrompt)
{
    <div class="legacy-migration-overlay">
        <div class="legacy-migration-card" @onclick:stopPropagation="true">
            <div class="legacy-migration-icon"><i class="bi bi-megaphone-fill"></i></div>
            <h2>Sisonke subscription plans are now available</h2>
            <p>
                Select your plan for <strong>@legacyStokvelName</strong> and receive 60 days free.
                No debit will occur until you select a plan, accept the subscription terms and authorise a payment method.
            </p>

            @if (isOfficeBearer)
            {
                <div class="d-flex gap-2 justify-content-center flex-wrap mt-3">
                    <button type="button" class="sisonke-btn sisonke-btn-outline" disabled="@isProcessingPrompt" @onclick="RemindMeLaterAsync">Remind me later</button>
                    <button type="button" class="sisonke-btn sisonke-btn-primary" disabled="@isProcessingPrompt" @onclick="SelectPlanAsync">Select your plan</button>
                </div>
            }
            else
            {
                <div class="sisonke-alert sisonke-alert-blue text-start mt-3">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Ask your chairperson or treasurer to complete this. Share this link with them:
                    <div class="legacy-migration-share-link mt-2">
                        <code>@ShareLink</code>
                    </div>
                </div>
                <div class="d-flex justify-content-center mt-3">
                    <button type="button" class="sisonke-btn sisonke-btn-outline" disabled="@isProcessingPrompt" @onclick="RemindMeLaterAsync">Remind me later</button>
                </div>
            }
        </div>
    </div>
}

<style>
    .legacy-migration-overlay {
        position: fixed;
        inset: 0;
        background: rgba(6, 47, 102, .55);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1080;
        padding: 1rem;
    }

    .legacy-migration-card {
        background: #fff;
        border-radius: var(--sk-radius-lg);
        box-shadow: var(--sk-shadow-lg);
        max-width: 480px;
        width: 100%;
        padding: 2rem;
        text-align: center;
    }

    .legacy-migration-icon {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 50%;
        background: var(--sk-green-50);
        color: var(--sk-green-800);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin: 0 auto 1rem;
    }

    .legacy-migration-card h2 {
        font-family: "Playfair Display", Georgia, "Times New Roman", serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--sk-text);
        margin-bottom: .75rem;
    }

    .legacy-migration-card p {
        color: var(--sk-text-muted);
        font-size: .9rem;
        line-height: 1.55;
        margin: 0;
    }

    .legacy-migration-share-link {
        word-break: break-all;
        font-size: .8rem;
    }
</style>

@code {
    private const string SessionStorageKey = "sisonke-legacy-migration-deferred";

    private bool showSubscriptionPrompt;
    private bool isProcessingPrompt;
    private bool isOfficeBearer;
    private Guid legacyStokvelId;
    private string? legacyStokvelName;

    private string ShareLink => NavigationManager.ToAbsoluteUri($"/register-stokvel/{legacyStokvelId}").ToString();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Deliberately NOT in OnInitializedAsync: this component is rendered from MainLayout as a
        // sibling of @Body (the actual page). MemberAccessService is Scoped and holds a single
        // ApplicationDbContext for the whole circuit (not an IDbContextFactory) — if this
        // component's data load ran concurrently with the page's own OnInitializedAsync (which
        // very often also calls MemberAccessService, e.g. StokvelDashboard.razor), both would
        // race on the same DbContext instance and throw "A second operation was started on this
        // context instance before a previous operation completed." Waiting for firstRender means
        // this only runs once the entire initial render — including the page content — has
        // already finished, so there is nothing left to race with. This also sidesteps needing
        // the try/catch around JS interop below for anything other than defensive belt-and-braces,
        // since JS interop is guaranteed available by the time OnAfterRenderAsync fires (unlike
        // OnInitializedAsync during prerendering).
        if (!firstRender)
        {
            return;
        }

        await LoadLegacyMigrationStateAsync();
        StateHasChanged();
    }

    private async Task LoadLegacyMigrationStateAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrWhiteSpace(userId))
        {
            return;
        }

        bool alreadyDeferred;
        try
        {
            var deferred = await JsRuntime.InvokeAsync<string?>("sessionStorage.getItem", SessionStorageKey);
            alreadyDeferred = deferred == "true";
        }
        catch (InvalidOperationException)
        {
            // Defensive — JS interop should be available here, but treat any failure as not-yet-deferred.
            alreadyDeferred = false;
        }

        if (alreadyDeferred)
        {
            return;
        }

        var memberships = await MemberAccessService.GetLinkedMembershipsForUserAsync(userId);
        var seenTenants = new HashSet<Guid>();

        foreach (var member in memberships)
        {
            if (!seenTenants.Add(member.TenantId))
            {
                continue;
            }

            var stokvel = await StokvelService.GetStokvelByTenantIdAsync(member.TenantId);
            if (stokvel is null)
            {
                continue;
            }

            var snapshot = await EntitlementService.GetSnapshotAsync(stokvel.Id);
            if (snapshot.Status != SubscriptionStatus.LegacyUnsubscribed)
            {
                continue;
            }

            legacyStokvelId = stokvel.Id;
            legacyStokvelName = stokvel.Name;
            isOfficeBearer = await MemberAccessService.IsOfficeBearerAsync(userId, stokvel.Id);
            showSubscriptionPrompt = true;
            break;
        }
    }

    private async Task RemindMeLaterAsync()
    {
        if (isProcessingPrompt)
        {
            return;
        }

        isProcessingPrompt = true;

        try
        {
            await JsRuntime.InvokeVoidAsync("sessionStorage.setItem", SessionStorageKey, "true");
        }
        catch (InvalidOperationException ex)
        {
            // Best-effort — if JS interop isn't available the prompt simply reappears next render.
            Logger.LogDebug(ex, "Could not persist legacy subscription prompt deferral for stokvel {StokvelId}.", legacyStokvelId);
        }
        finally
        {
            showSubscriptionPrompt = false;
            isProcessingPrompt = false;
        }
    }

    private async Task SelectPlanAsync()
    {
        if (isProcessingPrompt)
        {
            return;
        }

        isProcessingPrompt = true;

        try
        {
            showSubscriptionPrompt = false;
            await JsRuntime.InvokeVoidAsync("sessionStorage.setItem", SessionStorageKey, "true");
            NavigationManager.NavigateTo($"/register-stokvel/{legacyStokvelId}");
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogDebug(ex, "Could not persist legacy subscription prompt selection for stokvel {StokvelId}.", legacyStokvelId);
            NavigationManager.NavigateTo($"/register-stokvel/{legacyStokvelId}");
        }
        finally
        {
            isProcessingPrompt = false;
        }
    }
}
