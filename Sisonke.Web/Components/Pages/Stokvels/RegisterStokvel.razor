@code {
    [Parameter]
    public Guid? StokvelId { get; set; }

    [SupplyParameterFromQuery]
    public string? Step { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private readonly RegisterStokvelFormModel model = new();
    private List<string> provinces = SouthAfricanLocations.GetProvinces();
    private List<string> towns = new();
    private List<PlanCatalogueEntry> catalogueEntries = [];
    private ApplicationUser? currentUser;
    private bool saveFailed;
    private bool packageSelectionFailed;
    private bool isLoading = true;
    private bool isSaving;
    private bool isExistingOrganisation;
    private Guid? selectedPlanId;
    private int currentWizardStep = 1;
    private string? wizardValidationMessage;
    private string? capturedIpAddress;
    private DateTime? trialEndsAt;
    private DateTime? nextBillingAt;
    private SubscriptionPlan? memberCountWarningPlan;

    private ArchetypeOption? SelectedArchetypeOption =>
        archetypeOptions.FirstOrDefault(a => a.Archetype == model.Archetype);

    private PlanCatalogueEntry? SelectedCatalogueEntry =>
        selectedPlanId is null ? null
        : catalogueEntries.FirstOrDefault(entry => entry.Plan.Id == selectedPlanId.Value);

    private DateTime FirstChargeDate => DateTime.UtcNow.AddDays(PaystackOptions.TrialDays).Date;

    private void SelectPlan(Guid planId)
    {
        var selectedPlan = catalogueEntries.Select(entry => entry.Plan).FirstOrDefault(plan => plan.Id == planId);
        if (selectedPlan?.Code is null)
        {
            wizardValidationMessage = "The selected subscription plan is no longer available.";
            selectedPlanId = null;
            model.SelectedPlanCode = null;
            return;
        }

        selectedPlanId = selectedPlan.Id;
        model.SelectedPlanCode = selectedPlan.Code;
        packageSelectionFailed = false;
        wizardValidationMessage = null;
        memberCountWarningPlan = catalogueEntries
            .Select(e => e.Plan)
            .FirstOrDefault(p => p.MaximumMembers != null && model.ExpectedMemberCount > p.MaximumMembers && p.Id == planId)
            is not null
            ? catalogueEntries.Select(e => e.Plan).FirstOrDefault(p =>
                p.MaximumMembers == null || model.ExpectedMemberCount <= p.MaximumMembers)
            : null;
    }

    private async Task OnExpectedMemberCountChangedAsync(int? expectedMemberCount)
    {
        model.ExpectedMemberCount = expectedMemberCount;
        if (selectedPlanId is not null)
        {
            SelectPlan(selectedPlanId.Value);
        }
        else
        {
            var recommended = await PlanCatalogueService.RecommendPlanForMemberCountAsync(expectedMemberCount);
            if (recommended?.Code is not null)
            {
                selectedPlanId = recommended.Id;
                model.SelectedPlanCode = recommended.Code;
            }
        }
    }

    private async Task GoToStep2Async()
    {
        wizardValidationMessage = null;
        saveFailed = false;

        if (string.IsNullOrWhiteSpace(model.Name))
        {
            wizardValidationMessage = "Please enter a stokvel name to continue.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.CreatorFullName))
        {
            wizardValidationMessage = "Please enter the office bearer's full name to continue.";
            return;
        }
        if (string.IsNullOrWhiteSpace(model.CreatorCellphoneNumber) || !IsValidSaMobile(model.CreatorCellphoneNumber))
        {
            wizardValidationMessage = "Please enter a valid South African cellphone number (e.g. 0821234567).";
            return;
        }
        var bankingValidation = ValidateBankingDetails();
        if (bankingValidation is not null)
        {
            wizardValidationMessage = bankingValidation;
            return;
        }

        if (isExistingOrganisation)
        {
            currentWizardStep = 2;
            return;
        }

        isSaving = true;
        var createdStokvel = await StokvelService.RegisterStokvelAsync(
            model.Name, StokvelService.MapArchetypeToStokvelType(model.Archetype), model.Archetype,
            model.Province, model.TownOrArea, model.EstablishedDate, model.ExpectedMemberCount,
            model.Description, BuildBankingDetailsForCreate(), currentUser!.Id,
            string.IsNullOrWhiteSpace(model.RegistrationType) ? null : Enum.Parse<StokvelRegistrationType>(model.RegistrationType));

        if (createdStokvel is null)
        {
            isSaving = false;
            saveFailed = true;
            return;
        }

        var creatorMember = await MemberService.EnsureCreatorMemberForStokvelAsync(
            createdStokvel.Id, currentUser.Id, model.CreatorFullName,
            model.CreatorEmail ?? currentUser.Email, model.CreatorCellphoneNumber,
            model.CreatorIdNumber, model.CreatorResidentialArea);

        if (creatorMember is null)
        {
            isSaving = false;
            saveFailed = true;
            return;
        }

        await MemberAccountLinkingService.RefreshUserMembershipLinksAsync(currentUser.Id, model.CreatorIdNumber);

        StokvelId = createdStokvel.Id;
        isExistingOrganisation = true;
        isSaving = false;
        currentWizardStep = 2;
        NavigationManager.NavigateTo($"/register-stokvel/{StokvelId}", replace: true);
    }

    private void GoBackToStep1()
    {
        wizardValidationMessage = null;
        currentWizardStep = 1;
    }

    private async Task ContinueToBillingAsync()
    {
        if (isSaving)
        {
            return;
        }

        wizardValidationMessage = null;
        packageSelectionFailed = false;

        if (selectedPlanId is null)
        {
            packageSelectionFailed = true;
            wizardValidationMessage = "Please select a subscription plan.";
            return;
        }

        isSaving = true;
        try
        {
            var selectedPlan = await PlanCatalogueService.GetActivePlanAsync(selectedPlanId.Value);
            if (selectedPlan?.Code is null)
            {
                selectedPlanId = null;
                model.SelectedPlanCode = null;
                wizardValidationMessage = "The selected subscription plan is no longer available.";
                packageSelectionFailed = true;
                return;
            }

            selectedPlanId = selectedPlan.Id;
            model.SelectedPlanCode = selectedPlan.Code;
            Logger.LogInformation(
                "Subscription plan selected during stokvel registration. StokvelId: {StokvelId}, PlanId: {PlanId}, WizardStep: {WizardStep}",
                StokvelId, selectedPlanId, currentWizardStep);
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Failed to validate selected subscription plan. StokvelId: {StokvelId}, PlanId: {PlanId}, WizardStep: {WizardStep}",
                StokvelId, selectedPlanId, currentWizardStep);
            wizardValidationMessage = "We could not validate that subscription plan. Please try again.";
            return;
        }
        finally
        {
            isSaving = false;
        }

        packageSelectionFailed = false;
        model.BillingEmail ??= model.CreatorEmail ?? currentUser?.Email;
        model.CardholderName ??= model.CreatorFullName;
        currentWizardStep = 3;
        await InvokeAsync(StateHasChanged);
    }

    private void GoBackToStep2()
    {
        wizardValidationMessage = null;
        currentWizardStep = 2;
    }

    private async Task AuthoriseCardAsync()
    {
        wizardValidationMessage = null;

        if (string.IsNullOrWhiteSpace(model.CardholderName) || string.IsNullOrWhiteSpace(model.BillingEmail))
        {
            wizardValidationMessage = "Please enter the cardholder name and billing email.";
            return;
        }
        if (!model.TermsAccepted)
        {
            wizardValidationMessage = "Please accept the subscription terms to continue.";
            return;
        }
        if (StokvelId is null || model.SelectedPlanCode is null)
        {
            wizardValidationMessage = "Something went wrong — please start again from the plan step.";
            return;
        }

        isSaving = true;

        var selectResult = await SubscriptionService.SelectPlanAsync(
            StokvelId.Value, model.SelectedPlanCode, BillingTermsVersion.Current, currentUser!.Id, capturedIpAddress);

        if (!selectResult.Success)
        {
            isSaving = false;
            wizardValidationMessage = selectResult.Message;
            return;
        }

        // Persist cardholder name / billing address (display-only — never card data) directly,
        // since SelectPlanAsync's signature only carries plan/terms fields.
        await using (var scope = ScopeFactory.CreateAsyncScope())
        {
            var db = scope.ServiceProvider.GetRequiredService<Data.ApplicationDbContext>();
            var subscription = await db.OrganisationSubscriptions
                .Where(s => s.StokvelId == StokvelId.Value)
                .OrderByDescending(s => s.CreatedAt)
                .FirstOrDefaultAsync();
            if (subscription is not null)
            {
                subscription.CardholderName = model.CardholderName;
                subscription.BillingAddress = model.BillingAddress;
                subscription.UpdatedAt = DateTime.UtcNow;
                subscription.RowVersion = Guid.NewGuid().ToByteArray();
                await db.SaveChangesAsync();
            }
        }

        var callbackUrl = NavigationManager.ToAbsoluteUri(
            $"/billing/payment-callback?intent=onboarding&stokvelId={StokvelId}&redirect={Uri.EscapeDataString($"/register-stokvel/{StokvelId}")}").ToString();

        var authResult = await SubscriptionService.BeginCardAuthorisationAsync(
            StokvelId.Value, model.BillingEmail, model.CardholderName, model.CreatorCellphoneNumber, callbackUrl);

        if (!authResult.Success || string.IsNullOrWhiteSpace(authResult.AuthorisationUrl))
        {
            isSaving = false;
            wizardValidationMessage = authResult.Message ?? "Could not start card authorisation. Please try again.";
            return;
        }

        NavigationManager.NavigateTo(authResult.AuthorisationUrl, forceLoad: true);
    }

    private readonly List<ArchetypeOption> archetypeOptions =
    [
        new(StokvelArchetype.BurialSociety, "Burial Society",       "Manage funeral support, dependents, claims and member contributions.",              "Full support", false, "bi-heart-fill"),
        new(StokvelArchetype.Rotational,    "Rotational Stokvel",   "Members contribute regularly and the full pot is paid to one member in turn.",     "Demo ready",  false, "bi-arrow-repeat"),
        new(StokvelArchetype.SavingsClub,   "Savings Club",         "Save towards year-end, school fees, holidays or shared goals.",                     "Basic setup",  false, "bi-piggy-bank-fill"),
        new(StokvelArchetype.Grocery,       "Grocery Stokvel",      "Plan bulk grocery contributions, purchases and distribution.",                      "Coming soon",  true,  "bi-bag-fill"),
        new(StokvelArchetype.InvestmentClub,"Investment Club",      "Pool funds for long-term wealth and asset growth.",                                 "Coming soon",  true,  "bi-graph-up"),
        new(StokvelArchetype.Education,     "Education Stokvel",    "Save for school fees, uniforms, stationery and education costs.",                   "Coming soon",  true,  "bi-mortarboard-fill"),
        new(StokvelArchetype.Borrowing,     "Borrowing Stokvel",    "Manage member borrowing, limits, interest and repayments.",                        "Coming soon",  true,  "bi-cash-coin"),
        new(StokvelArchetype.Travel,        "Travel Stokvel",       "Save together for group trips, holidays and travel goals.",                         "Coming soon",  true,  "bi-airplane"),
        new(StokvelArchetype.SocialClub,    "Social Club",          "Manage events, celebrations and community activities.",                             "Coming soon",  true,  "bi-people-fill")
    ];

    protected override async Task OnInitializedAsync()
    {
        capturedIpAddress = HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress?.ToString();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(userId))
        {
            currentUser = await LoadCurrentUserAsync(userId);
        }

        if (currentUser is not null)
        {
            model.CreatorFullName = currentUser.FullName ?? string.Empty;
            model.CreatorCellphoneNumber = currentUser.CellphoneNumber ?? string.Empty;
            model.CreatorEmail = currentUser.Email;
            model.CreatorIdNumber = currentUser.IdNumber;
            model.CreatorResidentialArea = currentUser.ResidentialArea;
        }

        catalogueEntries = (await PlanCatalogueService.GetPublicPlansAsync()).ToList();

        if (StokvelId is not null)
        {
            await ResolveResumeStateAsync(StokvelId.Value);
        }

        isLoading = false;
    }

    private async Task ResolveResumeStateAsync(Guid stokvelId)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<Data.ApplicationDbContext>();

        var stokvel = await db.Stokvels.AsNoTracking().FirstOrDefaultAsync(s => s.Id == stokvelId);
        if (stokvel is null)
        {
            StokvelId = null;
            return;
        }

        isExistingOrganisation = true;
        model.Name = stokvel.Name;
        model.Archetype = stokvel.Archetype;
        model.Province = stokvel.Province;
        model.TownOrArea = stokvel.TownOrArea;
        model.EstablishedDate = stokvel.EstablishedDate;
        model.ExpectedMemberCount = stokvel.ExpectedMemberCount;
        model.Description = stokvel.Description;
        model.RegistrationType = stokvel.RegistrationType?.ToString();

        var subscription = await db.OrganisationSubscriptions
            .AsNoTracking()
            .Include(s => s.SubscriptionPlan)
            .Where(s => s.StokvelId == stokvelId)
            .OrderByDescending(s => s.CreatedAt)
            .FirstOrDefaultAsync();

        if (subscription is null || subscription.Status == SubscriptionStatus.LegacyUnsubscribed)
        {
            currentWizardStep = 2;
            return;
        }

        if (subscription.Status == SubscriptionStatus.Trialing)
        {
            selectedPlanId = subscription.SubscriptionPlanId;
            model.SelectedPlanCode = subscription.SubscriptionPlan?.Code;
            trialEndsAt = subscription.TrialEndsAt;
            nextBillingAt = subscription.NextBillingAt;
            currentWizardStep = 4;
            return;
        }

        if (subscription.Status == SubscriptionStatus.PendingPaymentMethod && subscription.SubscriptionPlan?.Code is not null)
        {
            selectedPlanId = subscription.SubscriptionPlanId;
            model.SelectedPlanCode = subscription.SubscriptionPlan.Code;
            currentWizardStep = 3;
            return;
        }

        // Any other status (Active, PastDue, etc.) means onboarding already completed previously.
        NavigationManager.NavigateTo("/subscription", replace: true);
    }

    private void OnProvinceChanged(ChangeEventArgs args)
    {
        model.Province = args.Value?.ToString();
        towns = SouthAfricanLocations.GetTownsByProvince(model.Province);
        model.TownOrArea = null;
    }

    private async Task<ApplicationUser?> LoadCurrentUserAsync(string currentUserId)
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<Data.ApplicationDbContext>();
        return await db.Users.AsNoTracking().FirstOrDefaultAsync(user => user.Id == currentUserId);
    }

    private sealed class RegisterStokvelFormModel
    {
        [Required][MaxLength(150)] public string Name { get; set; } = string.Empty;
        public StokvelArchetype Archetype { get; set; } = StokvelArchetype.BurialSociety;
        public string? RegistrationType { get; set; }
        [MaxLength(100)] public string? Province { get; set; }
        [MaxLength(100)] public string? TownOrArea { get; set; }
        public DateTime? EstablishedDate { get; set; }
        public int? ExpectedMemberCount { get; set; }
        [MaxLength(500)] public string? Description { get; set; }
        [Required][MaxLength(150)] public string CreatorFullName { get; set; } = string.Empty;
        [Required][MaxLength(30)] public string CreatorCellphoneNumber { get; set; } = string.Empty;
        [EmailAddress][MaxLength(150)] public string? CreatorEmail { get; set; }
        [MaxLength(30)] public string? CreatorIdNumber { get; set; }
        [MaxLength(150)] public string? CreatorResidentialArea { get; set; }
        [MaxLength(100)] public string? BankName { get; set; }
        [MaxLength(150)] public string? AccountHolderName { get; set; }
        [MaxLength(50)] public string? AccountNumber { get; set; }
        public BankAccountType AccountType { get; set; } = BankAccountType.Savings;
        [MaxLength(20)] public string? BranchCode { get; set; }
        [MaxLength(100)] public string? BranchName { get; set; }
        [MaxLength(200)] public string? PaymentReferenceFormat { get; set; }

        public string? SelectedPlanCode { get; set; }

