@page "/register-stokvel"
@page "/register-stokvel/{StokvelId:guid}"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.Security.Claims
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Sisonke.Web.Data
@using Sisonke.Web.Data.Entities
@using Sisonke.Web.Data.Enums
@using Sisonke.Web.Helpers
@using Sisonke.Web.Services
@using Sisonke.Web.Services.Billing
@using Sisonke.Web.Services.Billing.Paystack

@inject StokvelService StokvelService
@inject SubscriptionService SubscriptionService
@inject PlanCatalogueService PlanCatalogueService
@inject PaystackOptions PaystackOptions
@inject AuthSettings AuthSettings
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject MemberAccountLinkingService MemberAccountLinkingService
@inject MemberService MemberService
@inject IHttpContextAccessor HttpContextAccessor
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<RegisterStokvel> Logger

<PageTitle>Register New Stokvel</PageTitle>

@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner-border spinner-border-sm" role="status" style="color:var(--sk-green-700)">
            <span class="visually-hidden">Loading...</span>
        </div>
        Loading stokvel registration...
    </div>
}
else if (currentUser is null)
{
    <AlertBanner Type="warning" Title="Please sign in to register a stokvel." Message="" Icon="bi bi-exclamation-triangle-fill" />
}
else
{
    <!-- ── Wizard header ── -->
    <div class="rw-wizard-header mb-4">
        <div class="rw-brand">
            <div class="rw-brand-mark"><img src="/brand/sisonke-mark.svg" alt="" aria-hidden="true" /></div>
            <div>
                <div class="rw-brand-name">Sisonke</div>
                <div class="rw-brand-tagline">Together we save. Together we grow.</div>
            </div>
        </div>

        <div class="rw-steps">
            @for (var step = 1; step <= 4; step++)
            {
                var stepNumber = step;
                <div class="rw-step @(currentWizardStep == stepNumber ? "rw-step-active" : currentWizardStep > stepNumber ? "rw-step-done" : "")">
                    <div class="rw-step-circle">
                        @if (currentWizardStep > stepNumber) { <i class="bi bi-check-lg"></i> } else { <span>@stepNumber</span> }
                    </div>
                    <div class="rw-step-label">@StepLabel(stepNumber)</div>
                </div>
                @if (stepNumber < 4)
                {
                    <div class="rw-step-connector @(currentWizardStep > stepNumber ? "rw-step-connector-done" : "")"></div>
                }
            }
        </div>

        <a class="sisonke-btn sisonke-btn-outline" href="/my-workspace">
            <i class="bi bi-arrow-left me-2"></i>Cancel
        </a>
    </div>

    <!-- ── Feedback banners ── -->
    @if (saveFailed)
    {
        <AlertBanner Type="danger" Title="Unable to register stokvel." Message="Please check the details and try again." Icon="bi bi-x-circle-fill" />
    }
    @if (!string.IsNullOrWhiteSpace(wizardValidationMessage))
    {
        <AlertBanner Type="warning" Title="@wizardValidationMessage" Message="" Icon="bi bi-exclamation-triangle-fill" />
    }
    @if (!string.IsNullOrWhiteSpace(Error) && currentWizardStep == 3)
    {
        <AlertBanner Type="danger" Title="Card authorisation was not completed." Message="@Error" Icon="bi bi-x-circle-fill" />
    }

    <EditForm Model="@model" FormName="RegisterStokvelForm">
        <DataAnnotationsValidator />

        <!-- ══════════════ STEP 1 — Organisation ══════════════ -->
        @if (currentWizardStep == 1)
        {
            <div class="rw-step-panel">
                <div class="rw-step-title">
                    <h1>Create Your Organisation</h1>
                    <p>Tell us about your stokvel and who will be the first office bearer.</p>
                </div>

                @if (isExistingOrganisation)
                {
                    <div class="sisonke-alert sisonke-alert-blue mb-3">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        This organisation is already created — these details are locked. Continue to select a plan below.
                    </div>
                }

                @if (string.IsNullOrWhiteSpace(currentUser.IdNumber))
                {
                    <div class="sisonke-alert sisonke-alert-gold mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Your ID number is not on your account. Please update your profile before registering a stokvel.
                    </div>
                }

                @if (AuthSettings.RequireConfirmedAccount && currentUser.EmailConfirmed == false)
                {
                    <div class="sisonke-alert sisonke-alert-gold mb-3 d-flex align-items-start gap-2">
                        <i class="bi bi-envelope-exclamation-fill mt-1"></i>
                        <div>
                            Please verify your email address before continuing.
                            <a href="/Account/ResendEmailConfirmation">Resend confirmation email</a>.
                        </div>
                    </div>
                }

                <!-- Stokvel identity -->
                <fieldset disabled="@isExistingOrganisation">
                <div class="sisonke-card mb-3">
                    <div class="sisonke-card-body">
                        <div class="sisonke-card-head mb-3">
                            <div>
                                <h2>Stokvel Identity</h2>
                                <p>@GetIdentityPrompt()</p>
                            </div>
                        </div>
                        <div class="sisonke-grid sisonke-grid-2">
                            <div class="member-form-field">
                                <label class="form-label" for="stokvel-name">
                                    Stokvel name <span class="text-danger">*</span>
                                </label>
                                <InputText id="stokvel-name" class="form-control" placeholder="@GetStokvelNamePlaceholder()" @bind-Value="model.Name" />
                                <ValidationMessage For="@(() => model.Name)" class="text-danger small" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="registration-type">Registration type</label>
                                <select id="registration-type" class="form-select" @bind="model.Archetype">
                                    @foreach (var option in archetypeOptions)
                                    {
                                        <option value="@option.Archetype" disabled="@option.IsComingSoon">@option.Title</option>
                                    }
                                </select>
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="expected-member-count">Estimated total members</label>
                                <InputNumber id="expected-member-count" class="form-control" TValue="int?"
                                    Value="@model.ExpectedMemberCount"
                                    ValueChanged="@((int? v) => OnExpectedMemberCountChangedAsync(v))"
                                    ValueExpression="@(() => model.ExpectedMemberCount)" />
                                <div class="form-text">Helps Sisonke recommend the right plan.</div>
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="province">Province</label>
                                <select id="province" class="form-select" value="@model.Province" @onchange="OnProvinceChanged">
                                    <option value="">— Select province —</option>
                                    @foreach (var province in provinces)
                                    {
                                        <option value="@province">@province</option>
                                    }
                                </select>
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="town-or-area">Town or area</label>
                                <select id="town-or-area" class="form-select" @bind="model.TownOrArea" disabled="@(!towns.Any())">
                                    <option value="">— Select town/area —</option>
                                    @foreach (var town in towns)
                                    {
                                        <option value="@town">@town</option>
                                    }
                                </select>
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="established-date">Established date</label>
                                <InputDate id="established-date" class="form-control" @bind-Value="model.EstablishedDate" />
                            </div>
                            <div class="member-form-field register-form-wide">
                                <label class="form-label" for="description">
                                    Description <span class="text-muted fw-normal">(optional)</span>
                                </label>
                                <InputTextArea id="description" class="form-control" rows="2"
                                    placeholder="@GetDescriptionPlaceholder()"
                                    @bind-Value="model.Description" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stokvel category -->
                <div class="sisonke-card mb-3">
                    <div class="sisonke-card-body">
                        <div class="sisonke-card-head mb-3">
                            <div>
                                <h2>Stokvel Category</h2>
                                <p>Selected type: <strong>@(SelectedArchetypeOption?.Title ?? "Burial Society")</strong>. Choose the category that best describes how your group will save and share money.</p>
                            </div>
                        </div>
                        <InputRadioGroup @bind-Value="model.Archetype">
                            <div class="archetype-grid">
                                @foreach (var option in archetypeOptions)
                                {
                                    var isSelected = model.Archetype == option.Archetype && !option.IsComingSoon;
                                    <label class="archetype-card @(isSelected ? "archetype-card-selected" : "") @(option.IsComingSoon ? "archetype-card-soon" : "")">
                                        <InputRadio class="visually-hidden" Value="@option.Archetype" disabled="@option.IsComingSoon" />
                                        <div class="archetype-card-top">
                                            <div class="archetype-icon-wrap">
                                                <i class="bi @option.Icon"></i>
                                            </div>
                                            @if (isSelected)
                                            {
                                                <div class="archetype-check">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="archetype-title">@option.Title</div>
                                        <div class="archetype-description">@option.Description</div>
                                        @if (option.IsComingSoon)
                                        {
                                            <span class="@GetArchetypeBadgeClass(option)">@option.StatusText</span>
                                        }
                                    </label>
                                }
                            </div>
                        </InputRadioGroup>
                    </div>
                </div>

                <!-- Office bearer -->
                <div class="sisonke-card mb-3">
                    <div class="sisonke-card-body">
                        <div class="sisonke-card-head mb-3">
                            <div>
                                <h2>Primary Contact / Office Bearer</h2>
                                <p>You will be linked to this stokvel as the first office bearer and creator.</p>
                            </div>
                            <div class="rw-creator-pill">
                                <i class="bi bi-person-check-fill me-1"></i>
                                @SensitiveDataMasker.MaskEmail(currentUser.Email)
                            </div>
                        </div>
                        <div class="sisonke-grid sisonke-grid-2">
                            <div class="member-form-field">
                                <label class="form-label" for="creator-full-name">
                                    Full name <span class="text-danger">*</span>
                                </label>
                                <InputText id="creator-full-name" class="form-control" @bind-Value="model.CreatorFullName" />
                                <ValidationMessage For="@(() => model.CreatorFullName)" class="text-danger small" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="creator-cellphone">
                                    Cellphone <span class="text-danger">*</span>
                                </label>
                                <InputText id="creator-cellphone" class="form-control" placeholder="e.g. 0821234567" @bind-Value="model.CreatorCellphoneNumber" />
                                <ValidationMessage For="@(() => model.CreatorCellphoneNumber)" class="text-danger small" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="creator-email">Email address</label>
                                <InputText id="creator-email" class="form-control" @bind-Value="model.CreatorEmail" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="creator-id-number">SA ID number</label>
                                <InputText id="creator-id-number" class="form-control" placeholder="13-digit SA ID" @bind-Value="model.CreatorIdNumber" />
                                <div class="form-text">Links this record to your login account.</div>
                            </div>
                            <div class="member-form-field register-form-wide">
                                <label class="form-label" for="creator-area">Residential area</label>
                                <InputText id="creator-area" class="form-control" placeholder="e.g. Soweto, Gauteng" @bind-Value="model.CreatorResidentialArea" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Banking details -->
                <div class="sisonke-card mb-3">
                    <div class="sisonke-card-body">
                        <div class="sisonke-card-head mb-3">
                            <div>
                                <h2>Banking Details</h2>
                                <p>Add the stokvel bank account members should use for deposits and payouts.</p>
                            </div>
                            <span class="sisonke-badge sisonke-badge-gray">Optional</span>
                        </div>
                        <div class="sisonke-grid sisonke-grid-2">
                            <div class="member-form-field">
                                <label class="form-label" for="bank-name">Bank name</label>
                                <InputText id="bank-name" class="form-control" maxlength="100" placeholder="e.g. FNB" @bind-Value="model.BankName" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="account-holder-name">Account holder name</label>
                                <InputText id="account-holder-name" class="form-control" maxlength="150" placeholder="e.g. Local Test Stokvel" @bind-Value="model.AccountHolderName" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="account-number">Account number</label>
                                <InputText id="account-number" class="form-control" maxlength="50" inputmode="numeric" @bind-Value="model.AccountNumber" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="account-type">Account type</label>
                                <InputSelect id="account-type" class="form-select" @bind-Value="model.AccountType">
                                    @foreach (var accountType in Enum.GetValues<BankAccountType>())
                                    {
                                        <option value="@accountType">@GetBankAccountTypeLabel(accountType)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="branch-code">Branch code</label>
                                <InputText id="branch-code" class="form-control" maxlength="20" inputmode="numeric" @bind-Value="model.BranchCode" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="branch-name">Branch name</label>
                                <InputText id="branch-name" class="form-control" maxlength="100" @bind-Value="model.BranchName" />
                            </div>
                            <div class="member-form-field register-form-wide">
                                <label class="form-label" for="payment-reference">Payment reference format</label>
                                <InputText id="payment-reference" class="form-control" maxlength="200" placeholder="e.g. Member number + month" @bind-Value="model.PaymentReferenceFormat" />
                                <div class="form-text">This helps members use consistent references when making payments.</div>
                            </div>
                        </div>
                    </div>
                </div>
                </fieldset>

                <div class="rw-step-actions">
                    <a class="sisonke-btn sisonke-btn-outline" href="/my-workspace">Cancel</a>
                    <button type="button" class="sisonke-btn sisonke-btn-primary rw-btn-next" @onclick="GoToStep2Async" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Continue to Plan <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        }

        <!-- ══════════════ STEP 2 — Select Plan ══════════════ -->
        @if (currentWizardStep == 2)
        {
            <div class="rw-step-panel">
                <div class="rw-step-title">
                    <h1>Select Your Plan</h1>
                    <p>Every plan includes a 60-day free trial. Your card is only authorised in the next step — no charge happens now.</p>
                </div>

                @if (packageSelectionFailed)
                {
                    <AlertBanner Type="warning" Title="Please select a plan to continue." Message="" Icon="bi bi-exclamation-triangle-fill" />
                }

                @if (memberCountWarningPlan is not null)
                {
                    <div class="sisonke-alert sisonke-alert-gold mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Your estimated @model.ExpectedMemberCount members exceeds the selected plan's limit.
                        Consider <strong>@memberCountWarningPlan.Name</strong> instead, which supports up to
                        @(memberCountWarningPlan.MaximumMembers?.ToString() ?? "unlimited") members.
                    </div>
                }

                <div class="row g-3 mb-3">
                    @foreach (var entry in catalogueEntries)
                    {
                        var plan = entry.Plan;
                        var isSelected = selectedPlanId == plan.Id;
                        var isRecommended = plan.Code == PlanCodes.Professional;

                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="plan-card @(isSelected ? "plan-selected" : "") @(isRecommended && !isSelected ? "plan-recommended" : "") h-100"
                                 role="button"
                                 tabindex="0"
                                 @onclick="@(() => SelectPlan(plan.Id))">
                                <div class="card-body p-4 d-flex flex-column">
                                    @if (isRecommended)
                                    {
                                        <div class="text-center mb-2">
                                            <span class="sisonke-badge sisonke-badge-gold">Recommended</span>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                        <h3 class="h6 mb-0 fw-700">@plan.Name</h3>
                                        @if (isSelected)
                                        {
                                            <i class="bi bi-check-circle-fill" style="color:var(--sk-success);font-size:1.1rem;flex-shrink:0"></i>
                                        }
                                    </div>
                                    <p class="text-muted small mb-2">@GetMemberRangeText(plan)</p>
                                    <div class="plan-price mb-1">
                                        @if (plan.IsCustomPricing)
                                        {
                                            <span style="font-size:1.1rem">Custom pricing</span>
                                        }
                                        else
                                        {
                                            @FormatCurrency(plan.MonthlyPrice)<span class="text-muted fw-normal" style="font-size:.875rem">/mo</span>
                                        }
                                    </div>
                                    @if (!plan.IsCustomPricing)
                                    {
                                        <p class="text-muted small mb-3">60 days free. First charge @FirstChargeDate.ToString("d MMMM yyyy").</p>
                                    }
                                    <ul class="plan-features mt-auto mb-0">
                                        @foreach (var feature in entry.Features.Where(f => f.DataType == FeatureDataType.Boolean && f.IsEnabled).Take(8))
                                        {
                                            <li><i class="bi bi-check2 me-2" style="color:var(--sk-success)"></i>@feature.Name</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="sisonke-alert sisonke-alert-blue mb-3">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Payment processing fees for member collections (contributions, claims payouts) are separate from your
                    Sisonke subscription and are never bundled into the plan price above.
                </div>

                <div class="rw-step-actions">
                    @if (!isExistingOrganisation)
                    {
                        <button type="button" class="sisonke-btn sisonke-btn-outline" @onclick="GoBackToStep1">
                            <i class="bi bi-arrow-left me-2"></i>Back to Organisation
                        </button>
                    }
                    <button type="button" class="sisonke-btn sisonke-btn-primary rw-btn-next" @onclick="ContinueToBillingAsync" disabled="@isSaving">
                        Continue to Billing <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        }

        <!-- ══════════════ STEP 3 — Billing Method ══════════════ -->
        @if (currentWizardStep == 3)
        {
            <div class="rw-step-panel">
                <div class="rw-step-title">
                    <h1>Add Billing Method</h1>
                    <p>Your card details are captured securely on Paystack's hosted page — Sisonke never stores your card number, expiry date or CVV.</p>
                </div>

                <div class="sisonke-alert sisonke-alert-blue mb-3">
                    <i class="bi bi-credit-card-2-front me-2"></i>
                    A recurring-capable card is required for the subscription. Ozow EFT and Capitec Pay work for member
                    contribution collections, but cannot be used to authorise this subscription.
                </div>

                <div class="sisonke-card mb-3">
                    <div class="sisonke-card-body">
                        <div class="sisonke-card-head mb-3">
                            <h2>Billing Details</h2>
                        </div>
                        <div class="sisonke-grid sisonke-grid-2">
                            <div class="member-form-field">
                                <label class="form-label" for="cardholder-name">
                                    Cardholder name <span class="text-danger">*</span>
                                </label>
                                <InputText id="cardholder-name" class="form-control" @bind-Value="model.CardholderName" />
                            </div>
                            <div class="member-form-field">
                                <label class="form-label" for="billing-email">
                                    Billing email <span class="text-danger">*</span>
                                </label>
                                <InputText id="billing-email" class="form-control" @bind-Value="model.BillingEmail" />
                            </div>
                            <div class="member-form-field register-form-wide">
                                <label class="form-label" for="billing-address">Billing address</label>
                                <InputTextArea id="billing-address" class="form-control" rows="2" @bind-Value="model.BillingAddress" />
                            </div>
                        </div>
                    </div>
                </div>

                @if (SelectedCatalogueEntry is not null)
                {
                    <div class="rw-billing-summary mb-3">
                        <div class="rw-billing-summary-row">
                            <span>Plan</span>
                            <strong>@SelectedCatalogueEntry.Plan.Name</strong>
                        </div>
                        <div class="rw-billing-summary-row">
                            <span>Amount after trial</span>
                            <strong>@FormatCurrency(SelectedCatalogueEntry.Plan.MonthlyPrice)/month</strong>
                        </div>
                        <div class="rw-billing-summary-row">
                            <span>Trial ends</span>
                            <strong>@FirstChargeDate.ToString("d MMMM yyyy")</strong>
                        </div>
                        <div class="rw-billing-summary-row">
                            <span>First billing date</span>
                            <strong>@FirstChargeDate.ToString("d MMMM yyyy")</strong>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Cancel before this date and you will not be charged.</p>
                    </div>
                }

                <div class="sisonke-card mb-3">
                    <div class="sisonke-card-body">
                        <div class="form-check">
                            <InputCheckbox id="terms-accepted" class="form-check-input" @bind-Value="model.TermsAccepted" />
                            <label class="form-check-label small" for="terms-accepted">
                                I accept the Sisonke subscription terms (version @BillingTermsVersion.Current), including the
                                60-day introductory trial period and automatic monthly billing thereafter until cancelled.
                            </label>
                        </div>
                    </div>
                </div>

                <div class="rw-step-actions">
                    <button type="button" class="sisonke-btn sisonke-btn-outline" @onclick="GoBackToStep2" disabled="@isSaving">
                        <i class="bi bi-arrow-left me-2"></i>Back to Plan
                    </button>
                    <button type="button" class="sisonke-btn sisonke-btn-primary rw-btn-next" @onclick="AuthoriseCardAsync" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        <i class="bi bi-shield-lock-fill me-2"></i>Authorise Payment Method
                    </button>
                </div>
            </div>
        }

        <!-- ══════════════ STEP 4 — Complete ══════════════ -->
        @if (currentWizardStep == 4)
        {
            <div class="rw-step-panel text-center">
                <div class="rw-confirm-icon mb-3"><i class="bi bi-check-circle-fill"></i></div>
                <div class="rw-step-title">
                    <h1>You're All Set!</h1>
                    <p>Your 60-day free trial has started. A confirmation email is on its way.</p>
                </div>

                @if (SelectedCatalogueEntry is not null)
                {
                    <div class="rw-billing-summary mb-4" style="text-align:left;max-width:420px;margin-left:auto;margin-right:auto">
                        <div class="rw-billing-summary-row">
                            <span>Plan</span>
                            <strong>@SelectedCatalogueEntry.Plan.Name</strong>
                        </div>
                        <div class="rw-billing-summary-row">
                            <span>Trial ends</span>
                            <strong>@trialEndsAt?.ToString("d MMMM yyyy")</strong>
                        </div>
                        <div class="rw-billing-summary-row">
                            <span>First billing date</span>
                            <strong>@nextBillingAt?.ToString("d MMMM yyyy")</strong>
                        </div>
                    </div>
                }

                <div class="d-flex gap-2 justify-content-center flex-wrap">
                    <a class="sisonke-btn sisonke-btn-outline" href="/subscription">Manage Billing</a>
                    <a class="sisonke-btn sisonke-btn-primary" href="/stokvel-questionnaire/@StokvelId">
                        Continue Setup <i class="bi bi-arrow-right ms-2"></i>
                    </a>
