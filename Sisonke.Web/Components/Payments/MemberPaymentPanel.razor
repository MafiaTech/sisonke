@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Sisonke.Web.Data.Entities
@using Sisonke.Web.Data.Enums
@using Sisonke.Web.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MemberPaymentSubmissionService Submissions
@inject ILogger<MemberPaymentPanel> Logger

<section class="mt-3" aria-label="Member payment verification">
    <h3>@(ObligationType == PaymentObligationType.Fine ? "Fine payments" : "Contribution payments")</h3>
    <button type="button" class="sisonke-btn sisonke-btn-outline mb-3" disabled="@busy" @onclick="RefreshAsync">Refresh payment status</button>
    <p class="text-muted">Record a payment you have already made to your stokvel and attach proof for Treasurer verification. PDF, JPG or PNG, up to 10 MB.</p>
    @if (message is not null) { <div class="sisonke-alert sisonke-alert-green" role="status">@message</div> }
    @if (error is not null) { <div class="sisonke-alert sisonke-alert-gold" role="alert">@error</div> }
    @if (loading) { <p>Loading payment proofs...</p> }
    else if (contributions.Count == 0) { <p>No payment obligations available.</p> }
    else
    {
        <div class="member-payment-list">
            @foreach (var obligation in contributions)
            {
                var recent = submissions.FirstOrDefault(s => (s.MemberContributionId ?? s.MemberFineId) == obligation.Id);
                <article class="border rounded p-3 mb-3">
                    <h4 class="h6">@obligation.Description</h4>
                    <div class="sisonke-header-meta">
                        <span>Expected: R @obligation.Expected.ToString("N2")</span>
                        <span>Paid: R @obligation.Paid.ToString("N2")</span>
                        <strong>Outstanding: R @obligation.Outstanding.ToString("N2")</strong>
                        <span>@(ObligationType == PaymentObligationType.Fine ? "Issued" : "Due"): @obligation.Date.ToString("dd MMM yyyy")</span>
                        <span class="sisonke-badge sisonke-badge-gray">@obligation.Status</span>
                    </div>
                    @if (recent is not null)
                    {
                        <p class="mt-2 mb-2">@ProofStatus(recent)</p>
                        @if (recent.Status == ContributionPaymentSubmissionStatus.Rejected) { <p class="text-danger">@recent.RejectionReason</p> }
                    }
                    @if (obligation.Payable && recent?.Status != ContributionPaymentSubmissionStatus.Pending)
                    { <button type="button" class="sisonke-btn sisonke-btn-outline mt-2" disabled="@busy" @onclick="() => Select(obligation)">I've Paid</button> }
                </article>
            }
        </div>
    }
    @if (selected is not null)
    {
        <EditForm Model="form" OnSubmit="SubmitAsync" FormName="@($"payment-proof-{ObligationType}")">
            <fieldset disabled="@busy" class="border-0 p-0">
                <legend class="h5">Payment For: @selected.Description</legend>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="@(ControlId("amount"))" class="form-label">Amount Paid</label>
                        <div class="input-group sisonke-currency-input">
                            <span class="input-group-text" aria-hidden="true">R</span>
                            <input id="@(ControlId("amount"))" class="form-control" type="text" inputmode="numeric" pattern="[0-9]+" maxlength="16" required
                                   @bind:get="amountText" @bind:set="SetAmountText" @bind:event="oninput" aria-describedby="@(ControlId("amount-help"))" />
                            <span class="input-group-text" aria-hidden="true">.00</span>
                        </div>
                        <div id="@(ControlId("amount-help"))" class="form-text">Whole rand only. Outstanding: R @selected.Outstanding.ToString("N2")</div>
                    </div>
                    <div class="col-md-6"><label for="@(ControlId("date"))" class="form-label">Payment Date</label><InputDate id="@(ControlId("date"))" class="form-control" @bind-Value="form.PaymentDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                    <div class="col-md-6"><label for="@(ControlId("reference"))" class="form-label">Payment Reference</label><InputText id="@(ControlId("reference"))" class="form-control" @bind-Value="form.Reference" maxlength="100" /></div>
                    <div class="col-md-6"><label for="@(ControlId("file"))" class="form-label">Proof of Payment</label><InputFile @key="selected.Id" id="@(ControlId("file"))" class="form-control" OnChange="FileChanged" accept=".pdf,.jpg,.jpeg,.png" required /></div>
                    <div class="col-12"><label for="@(ControlId("notes"))" class="form-label">Optional Notes</label><InputTextArea id="@(ControlId("notes"))" class="form-control" @bind-Value="form.Notes" maxlength="1000" /></div>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3"><button type="submit" class="sisonke-btn sisonke-btn-primary">@(busy ? "Submitting..." : "Submit for verification")</button><button type="button" class="sisonke-btn sisonke-btn-outline" @onclick="() => selected = null">Cancel</button></div>
            </fieldset>
        </EditForm>
    }
    @if (submissions.Count > 0)
    {
        <details class="mt-3"><summary>Recent proof submissions</summary>
            @foreach (var submission in submissions.Take(20))
            {
                <div class="border-bottom py-2">
                    @submission.PaymentFor — R @submission.Amount.ToString("N2") —
                    @ProofStatus(submission)
                    @if (submission.RejectionReason is not null) { <p>@submission.RejectionReason</p> }
                    @foreach (var doc in submission.Documents) { <a class="ms-2" href="@($"/api/payment-proofs/{StokvelId}/{doc.Id}")" target="_blank" rel="noopener">View Proof</a> }
                </div>
            }
        </details>
    }
</section>

@code {
    [Parameter] public Guid StokvelId { get; set; }
    [Parameter] public PaymentObligationType ObligationType { get; set; } = PaymentObligationType.Contribution;
    [Parameter] public EventCallback BalancesRefreshed { get; set; }
    private (Guid, PaymentObligationType)? loadedKey;
    private string amountText = "";
    private string userId = "";
    private bool loading = true, busy;
    private string? error, message;
    private List<PaymentObligation> contributions = [];
    private List<ContributionPaymentSubmission> submissions = [];
    private PaymentObligation? selected;
    private IBrowserFile? file;
    private ProofForm form = new();

    protected override async Task OnParametersSetAsync()
    {
        if (loadedKey == (StokvelId, ObligationType)) return;
        loadedKey = (StokvelId, ObligationType);
        loading = true; selected = null; error = null; message = null;
        contributions = []; submissions = [];
        userId = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        try { await LoadAsync(); } catch (Exception ex) { ShowError(ex); }
        finally { loading = false; }
    }
    private async Task LoadAsync()
    {
        contributions = await Submissions.GetMemberObligationsAsync(userId, StokvelId, ObligationType);
        submissions = (await Submissions.GetMemberSubmissionsAsync(userId, StokvelId)).Where(s => s.ObligationType == ObligationType).ToList();
    }
    private void Select(PaymentObligation contribution)
    {
        selected = contribution; file = null; error = null; message = null;
        form = new();
        amountText = decimal.Truncate(contribution.Outstanding).ToString("0", System.Globalization.CultureInfo.InvariantCulture);
    }
    private string ControlId(string field) => ObligationType == PaymentObligationType.Contribution ? $"proof-{field}" : $"fine-proof-{field}";
    private void SetAmountText(string? value)
    {
        value ??= "";
        if (WholeRandAmount.IsDigits(value) && value.Length <= 16) { amountText = value; error = null; }
        else error = "Use digits only for a whole-rand amount.";
    }
    private static string ProofStatus(ContributionPaymentSubmission? submission) => submission?.Status switch
    {
        ContributionPaymentSubmissionStatus.Pending => "Awaiting Treasurer verification",
        ContributionPaymentSubmissionStatus.Approved => "Approved",
        ContributionPaymentSubmissionStatus.Rejected => "Rejected — resubmit",
        _ => "Not submitted"
    };
    private async Task RefreshAsync()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            await LoadAsync();
            if (selected is not null) selected = contributions.FirstOrDefault(c => c.Id == selected.Id);
            await BalancesRefreshed.InvokeAsync();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { busy = false; }
    }
    private void FileChanged(InputFileChangeEventArgs args) => file = args.File;
    private async Task SubmitAsync()
    {
        if (busy || selected is null) return;
        busy = true; error = null; message = null;
        try
        {
            if (!WholeRandAmount.TryParse(amountText, out var amount))
                throw new InvalidOperationException("Enter a whole-rand amount greater than zero.");
            PaymentObligationHandlers.For(ObligationType).ValidateAmount(selected, amount);
            if (file is null) throw new InvalidOperationException("Choose a proof of payment file.");
            await Submissions.SubmitAsync(userId, StokvelId, ObligationType, selected.Id, amount, form.PaymentDate, form.Reference, form.Notes, file);
            selected = null; file = null;
            message = "Awaiting Treasurer verification";
            await LoadAsync();
            await BalancesRefreshed.InvokeAsync();
        }
        catch (Exception ex) { ShowError(ex); }
        finally { busy = false; }
    }
    private void ShowError(Exception ex)
    {
        Logger.LogWarning(ex, "Payment proof operation failed for stokvel {StokvelId}", StokvelId);
        error = ex is InvalidOperationException ? ex.Message : "Unable to process the proof. Check your access, then refresh and try again.";
    }
    private sealed class ProofForm
    {
        public DateTime PaymentDate { get; set; } = DateTime.Today;
        public string? Reference { get; set; }
        public string? Notes { get; set; }
    }
}

